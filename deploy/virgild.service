# /etc/systemd/system/virgild.service
[Unit]
Description=Virgil music player (web UI, library, DAC arbitration)
After=network-online.target sound.target mpd.socket mpd.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/virgild --config /etc/virgil/virgild.toml
Restart=on-failure
RestartSec=2

DynamicUser=yes
StateDirectory=virgil
# Serve the UI on port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# Downloaded covers are saved into the album folders.
ReadWritePaths=/mnt/music
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=multi-user.target
