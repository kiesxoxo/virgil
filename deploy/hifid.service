# /etc/systemd/system/hifid.service
[Unit]
Description=hifi music player (web UI, library, DAC arbitration)
After=network-online.target sound.target mpd.socket mpd.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/hifid --config /etc/hifi/hifid.toml
Restart=on-failure
RestartSec=2

DynamicUser=yes
StateDirectory=hifi
# Serve the UI on port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=multi-user.target
